# ==============================================================================
# ANVESHANA VIDYA (DIGITAL FORENSICS LEARNING PLATFORM) - ENVIRONMENT VARIABLES
# ==============================================================================

# AI PROVIDER 1: Google Gemini API (Recommended & Free Tier Available)
# Get your free API key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# AI PROVIDER 2: OpenAI API (GPT-4o-mini / GPT-4o)
# Get your API key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Default Active AI Provider ('gemini' | 'openai' | 'auto')
VITE_DEFAULT_AI_PROVIDER=auto

# Optional Application Configuration
VITE_APP_TITLE=Anveshana Vidya - Digital Forensics Learning Platform
VITE_APP_ENV=development
